### C#
# Build results
[Bb]in/
[Oo]bj/

# Visual Studio cache/options directory
.vs/

# User-specific files
*.suo
*.user
*.userprefs
*.rsuser

# Debug symbols
*.pdb

# NuGet Packages
*.nupkg

# Ignore NuGet packages folders, but do NOT ignore Unity root Packages folder
**/[Pp]ackages/*
!/[Pp]ackages/
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json
!**/[Pp]ackages/build/

# .NET build artifacts
artifacts/

# Publish output
publish/


