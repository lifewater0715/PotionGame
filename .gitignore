### Unity
# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/

# Unity Package Manager cache
/[Ll]ibrary/[Pp]ackage[Cc]ache/

# Keep Unity Assets folder and meta files
!/[Aa]ssets/
!/[Aa]ssets/**
!/[Aa]ssets/**/*.meta

# Keep Unity package manifest files
!/[Pp]ackages/
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# Keep Unity project settings
!/[Pp]roject[Ss]ettings/
!/[Pp]roject[Ss]ettings/**

# Optional Unity local settings should usually not be shared
/[Uu]ser[Ss]ettings/

# Unity build output
*.apk
*.aab
*.unitypackage
*.tgz

# Autogenerated solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.booproj
*.svd
*.pidb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt


